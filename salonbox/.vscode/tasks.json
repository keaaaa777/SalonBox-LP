{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SalonBox LP: ローカルサーバー",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "http.server",
        "8080",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "salonbox-local-server",
        "pattern": [
          {
            "regexp": "^__VSCODE_NO_PROBLEM_MATCH__:(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "endsPattern": "Serving HTTP on 127\\.0\\.0\\.1 port 8080"
        }
      }
    }
  ]
}
